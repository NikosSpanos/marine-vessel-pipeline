# scripts/create-env.sh turns this file into .env, replacing each change-me with a random value.
# .env is git-ignored. Never commit it.

# Superuser: used only when PostgreSQL initialises an empty data directory.
POSTGRES_DB=vessels
POSTGRES_USER=vessel_admin
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Application roles: created by database/00-roles.sh.
VESSEL_WRITER_PASSWORD=change-me
VESSEL_READER_PASSWORD=change-me
